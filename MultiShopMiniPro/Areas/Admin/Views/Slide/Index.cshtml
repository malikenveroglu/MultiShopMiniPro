
@model List<Slide>

@{
    int count = 0;
}

<div class="row">
    <div class="col-lg-12 grid-margin stretch-card">

        <div class="card">
            <div class="card-body">
                <h4 class="card-title">Slide Table</h4>
                <a class="btn btn-success" asp-action="Create"> Create </a>
                <div class="table-responsive">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th> No </th>
                                <th> Image </th>
                                <th> Title </th>
                                <th> Order </th>
                                <th> Settings </th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (Slide item in Model)
                            {
                                count++;
                                <tr>
                                    <td> @count </td>

                                    <td class="py-1">
                                        <img src="~/Admin/assets/images/@item.Image" alt="@item.Title" />
                                    </td>

                                    <td>
                                        @item.Title
                                    </td>

                                    <td> @item.Order </td>

                                    <td> 
                                        <a class="btn btn-primary"> <i> fa fa-edit </i> </a>
                                        <a class="btn btn-danger"> <i> fa fa-trash-o </i> </a>
                                        <a class="btn btn-success"> <i> fa fa-gears </i></a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>