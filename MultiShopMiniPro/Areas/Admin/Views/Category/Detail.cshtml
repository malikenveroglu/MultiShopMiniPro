@model Category

<div class="row">
    <div class="col-12 grid-margin stretch-card">
        <div class="card">
            <div class="card-body">
                <h4 class="card-title">Details of Category</h4>
                <form class="forms-sample" method="post">
                    <div class="form-group">
                        <label asp-for="Name">Name</label>
                        <input asp-for="Name" class="form-control" placeholder="Name" readonly>
                    </div>
                    <div class="form-group">
                        <img style="width:150px; height:150px;" src="~/assets/img/@Model.Image" />
                        <br />
                        <br />
                        <label asp-for="Image">Image</label>
                        <input asp-for="Image" class="form-control" placeholder="Image" readonly hidden>
                    </div>
                    <div class="form-group">
                        <label>Product Count</label>
                        <input value="@Model.ProductCount" class="form-control" readonly>
                    </div>
                    <button type="submit" class="btn btn-primary me-2" disabled>Submit</button>
                    <button asp-controller="category" asp-action="index" class="btn btn-dark">Cancel</button>
                </form>
            </div>
        </div>
    </div>
</div>