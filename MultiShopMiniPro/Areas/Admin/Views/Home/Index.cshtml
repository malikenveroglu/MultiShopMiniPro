<div class="row">
    <div class="col-12">
        <h3 class="mb-4">Dashboard</h3>
    </div>

    <div class="col-lg-4 grid-margin stretch-card">
        <div class="card">
            <div class="card-body text-center">
                <i class="fa fa-cubes" style="font-size:48px; color:#6c5ce7;"></i>
                <h4 class="card-title mt-3">Products</h4>
                <p class="card-description">Add, edit, delete and view product details.</p>
                <a asp-area="Admin" asp-controller="Product" asp-action="Index" class="btn btn-primary btn-lg">
                    <i class="fa fa-arrow-right"></i> Go to Products
                </a>
            </div>
        </div>
    </div>

    <div class="col-lg-4 grid-margin stretch-card">
        <div class="card">
            <div class="card-body text-center">
                <i class="fa fa-list-alt" style="font-size:48px; color:#00b894;"></i>
                <h4 class="card-title mt-3">Categories</h4>
                <p class="card-description">Manage the categories used by your products.</p>
                <a asp-area="Admin" asp-controller="Category" asp-action="Index" class="btn btn-success btn-lg">
                    <i class="fa fa-arrow-right"></i> Go to Categories
                </a>
            </div>
        </div>
    </div>

    <div class="col-lg-4 grid-margin stretch-card">
        <div class="card">
            <div class="card-body text-center">
                <i class="fa fa-picture-o" style="font-size:48px; color:#e17055;"></i>
                <h4 class="card-title mt-3">Slides</h4>
                <p class="card-description">Manage the homepage slider images.</p>
                <a asp-area="Admin" asp-controller="Slide" asp-action="Index" class="btn btn-warning btn-lg">
                    <i class="fa fa-arrow-right"></i> Go to Slides
                </a>
            </div>
        </div>
    </div>
</div>
<div class="col-12 grid-margin">
    <div class="card">
        <div class="card-body p-0">
            <img src="~/assets/img/dashboard-banner.jpg"
                 alt="Dashboard Banner"
                 class="img-fluid w-100"
                 style="border-radius:6px; display:block;" />
        </div>
    </div>
</div>