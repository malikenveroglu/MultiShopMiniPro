@model List<Category>

<div class="container-fluid pt-5 pb-3">
    <h2 class="section-title position-relative text-uppercase mx-xl-5 mb-4">
        <span class="bg-secondary pr-3">Shop by Category</span>
    </h2>

    <div class="row px-xl-5">
        @if (Model is not null && Model.Any())
        {
            @foreach (Category item in Model)
            {
                <div class="col-lg-3 col-md-4 col-sm-6 pb-1">
                    <a class="text-decoration-none" asp-controller="category" asp-action="detail" asp-route-id="@item.Id">
                        <div class="cat-item d-flex align-items-center mb-4">
                            <div class="overflow-hidden" style="width: 100px; height: 100px;">
                                <img class="img-fluid" src="~/assets/img/@item.Image" alt="@item.Name">
                            </div>
                            <div class="flex-fill pl-3">
                                <h6>@item.Name</h6>
                                <small class="text-body">@item.ProductCount products</small>
                            </div>
                        </div>
                    </a>
                </div>
            }
        }
        else
        {
            <p class="px-3">No categories available yet.</p>
        }
    </div>
</div>